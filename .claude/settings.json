{
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/agent-cleanup.sh --apply >> $CLAUDE_PROJECT_DIR/.claude/agent-cleanup.log 2>&1 || true",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
