<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.haoranwei.Cadence</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cadence</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<!-- T-626. iOS-only in effect, and shared in file because there is no way to make it
	     otherwise: INFOPLIST_KEY_UIBackgroundModes is not one of the INFOPLIST_KEY_* settings
	     Xcode's generator knows, so a build-setting spelling (sdk-conditional or not) resolves and
	     is then silently dropped from the built bundle. Measured 2026-09-14. macOS ships the key
	     and ignores it, exactly as it already ships and ignores the three UIKit keys below.
	     Pinned by AppStoreReviewReadinessTests.appInfoPlistContainsReviewReadyPrivacyKeys. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
	</array>
</dict>
</plist>
